{
  "name": "FHNW Room Booking - Python and FastAPI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements-test.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Room Booking API", "onAutoForward": "notify"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}
    }
  }
}
